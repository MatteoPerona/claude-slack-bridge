# Copy to ~/.claude/channels/slack/.env and chmod 600. Real environment variables win over this file.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Your Slack user ID (profile > More > Copy member ID)
SLACK_OWNERS=U0123456789
# The one channel ID the bridge listens and replies in
SLACK_CHANNELS=C0123456789
# Optional: app IDs allowed to post as you (e.g. a connector that posts with your user token)
SLACK_OWNER_APPS=
